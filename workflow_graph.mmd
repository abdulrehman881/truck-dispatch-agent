flowchart TB
  %% ============ ENTRY ============
  START((● START)):::working

  %% ============ INGESTION / QUALIFICATION ============
  subgraph SG1["▲  Lead ingestion & qualification pipeline"]
    upload["📄 Operator uploads<br/>FMCSA Register PDF<br/><i>/pipeline</i>"]:::working
    extract["🔍 extract_carriers<br/>USDOT · MC · company · phone"]:::working
    dupcheck{"⚖ duplicates /<br/>malformed entries?"}:::working
    reject["❌ duplicate & invalid<br/>rows reported, not lost"]:::refusal
    verify["✅ verify_fmcsa<br/>official API cross-check<br/><i>verified / uncertain / unavailable</i>"]:::working
    score["⭐ score & prioritize<br/>lead_score · fleet · category"]:::working
    import[("🗄 upsert carrier_leads<br/>PostgreSQL · provenance kept")]:::working
  end

  %% ============ WORKING THE LEAD ============
  subgraph SG2["▶  Working the leads"]
    resvc["🤝 reserve next carrier<br/><i>get_next_carrier · skips DNC + reserved</i>"]:::working
    callstart["📞 begin_call on /call console<br/>caller_key = usdot → phone →<br/>company → person"]:::working
    findpast{"⚖ returning caller?"}:::working
    fresh["💬 new greeting<br/><i>read-only rules stated</i>"]:::working
    resume["🔁 resume past transcript<br/>+ derived summary"]:::working
    turn["🗣 driver turn<br/>(voice ⇒ text ⇒ message)"]:::working
    intent{"🔒 change / delete /<br/>modify DB order?"}:::refusal
    flag["⚑ store flagged message<br/>event: call_data_change_refused"]:::refusal
    askgroq["🤖 groq gpt-oss-20b<br/>temp 0.4 · ≤250 tokens · no tools"]:::model
    reply["💬 agent replies<br/>(loads/lanes/equipment only)"]:::working
  end

  %% ============ OUTCOME / REVIEWS ============
  subgraph SG3["▼  Outcomes & scheduling"]
    review["📝 save carrier review<br/>interested · not_interested ·<br/>callback_requested · do_not_contact"]:::working
    interested["📈 interested path<br/>Excel export / pipeline report"]:::working
    nocall["🚫 do_not_contact<br/>excluded from outreach"]:::refusal
    insert[("📅 insert scheduled_tasks row<br/>task_type = callback · due_at")]:::working
    worker["⏱ due worker tick<br/>pending → due · notified_at<br/>event: task_due (every 30 s)"]:::worker
    remcard["🔔 Tasks card + chat reminder<br/><i>&#8220;mark task N done&#8221;</i>"]:::working
    done[("✅ task done / cancelled")]:::working
  end

  %% ============ OPERATOR ASSISTANT ============
  subgraph SG4["✨  Operator assistant (chat)"]
    omsg["💬 operator instruction"]:::working
    oblocked{"⚖ delete · dial ·<br/>billing request?"}:::refusal
    orefuse["🚷 refusal reply<br/>event: assistant_action_refused"]:::refusal
    oplan["🤖 plan action<br/>(groq → JSON · regex fallback)"]:::model
    oexec["⚡️ execute whitelisted action<br/>metrics · search · reserve · review ·<br/>remind · callbacks · excel · call carrier"]:::working
    ourl["📱 open /call console<br/>auto-connect session"]:::working
    oans["➡&#65039; reply + structured data"]:::working
  end

  %% ============ FUTURE ============
  subgraph SG5["🔄  Ahead (Job 2)"]
    ltalk["💬 load talk<br/>(never invents rates)"]:::future
    ldisc["🔍 load discovery<br/>load-board integration"]:::future
    lrate["💰 rate prep<br/>human confirms everything"]:::future
  end

  %% ========== FLOW: INGESTION ==========
  START --> upload --> extract --> dupcheck
  dupcheck -- "yes" --> reject
  dupcheck -- "no" --> verify --> import
  verify -- "invalid authority" --> reject
  import --> score --> import
  score -- "qualified" --> resvc

  %% ========== FLOW: CALL ==========
  resvc --> callstart --> findpast
  findpast -- "no" --> fresh --> turn
  findpast -- "yes" --> resume --> turn
  turn --> intent
  intent -- "yes" --> flag --> reply
  intent -- "no" --> askgroq --> reply
  reply --> turn
  reply -- "call ends" --> review

  %% ========== FLOW: OUTCOMES ==========
  review -- "interested" --> interested
  review -- "callback_requested" --> insert
  review -- "do_not_contact" --> nocall
  insert --> worker
  worker -- "due at time" --> remcard
  remcard --> done
  done -. "operator calls back on /call" .-> callstart

  %% ========== FLOW: ASSISTANT ==========
  omsg --> oblocked
  oblocked -- "yes" --> orefuse
  oblocked -- "no" --> oplan --> oexec --> oans
  oexec -- "place_outbound_call" --> ourl -.-> callstart

  %% ========== FLOW: FUTURE ==========
  reply -.-> ltalk
  ltalk -.-> ldisc -.-> lrate

  %% ========== STYLES ==========
  classDef working fill:#c9ecd6,stroke:#16a34a,stroke-width:2px,color:#143324;
  classDef model fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#152747;
  classDef refusal fill:#fde68a,stroke:#b45309,stroke-width:2px,color:#4a2c05;
  classDef worker fill:#fef9c3,stroke:#ca8a04,stroke-width:2px,color:#43300a;
  classDef future fill:#eef2ee,stroke:#94a3b8,stroke-width:2px,strokeDasharray:6 4,color:#475569;
  class START working;
  style SG1 fill:#fbfdfc,stroke:#dfe6df
  style SG2 fill:#fbfdfc,stroke:#dfe6df
  style SG3 fill:#fbfdfc,stroke:#dfe6df
  style SG4 fill:#fbfdfc,stroke:#dfe6df
  style SG5 fill:#fbfdfc,stroke:#dfe6df
