# TruckDispatchAgent environment template.
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file or paste real keys anywhere.

# --- AI providers ---
# Get one: https://console.groq.com/keys
GROQ_API_KEY=
# Get one: https://elevenlabs.io (Profile -> API Keys)
ELEVENLABS_API_KEY=
# Get one: https://mobile.fmcsa.dot.gov (request a WebKey)
FMCSA_WEB_KEY=

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=truck_dispatch_db
DB_USER=postgres
DB_PASSWORD=

# --- Access control ---
# Shared operator token for admin/data endpoints (/metrics, /carriers/
# search, /eligible-carriers, /next-carrier, /export-excel, mock-call,
# carrier-call-attempts, carrier-reviews). Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
